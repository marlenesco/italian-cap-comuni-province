{
  "name": "@marlenesco/italian-cap-comuni-province",
  "version": "1.2.0",
  "description": "Maintained fork of italian-cap-comuni-province: Italian municipalities, provinces, postal codes, search and autocomplete",
  "keywords": [
    "italy",
    "italian",
    "locations",
    "municipalities",
    "comuni",
    "provinces",
    "postal-codes",
    "cap",
    "geocoding",
    "search",
    "autocomplete",
    "typescript"
  ],
  "author": "SpritzCoder <spritzcoder@users.noreply.github.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marlenesco/italian-cap-comuni-province.git"
  },
  "bugs": {
    "url": "https://github.com/marlenesco/italian-cap-comuni-province/issues"
  },
  "homepage": "https://github.com/marlenesco/italian-cap-comuni-province#readme",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch src --watch scripts/data",
    "dev": "tsup --watch src --watch scripts/data",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build && npm run test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "data:build": "node scripts/data/build.mjs",
    "data:verify": "node scripts/data/cli.mjs verify",
    "data:check": "node scripts/data/cli.mjs check",
    "data:update": "node scripts/data/cli.mjs update",
    "pretest": "npm run data:build",
    "pretype-check": "npm run data:build",
    "prepack": "npm run build",
    "benchmark": "node scripts/benchmark.mjs",
    "test:package": "node scripts/test-package.mjs",
    "pretest:coverage": "npm run data:build",
    "test:build": "node scripts/test-build.mjs",
    "pretest:watch": "npm run data:build",
    "pretest:ui": "npm run data:build"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "@vitest/coverage-v8": "^1.6.0",
    "eslint": "^9.37.0",
    "tsup": "^8.1.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "contributors": [
    {
      "name": "David Foliti",
      "url": "https://github.com/marlenesco"
    }
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
